# Vite injects these at build time. On Vercel add them under
# Project Settings -> Environment Variables (same names).
VITE_GROQ_API_KEY=your_groq_api_key
# Optional second key: used for round-robin rotation and rate-limit cooldown.
VITE_GROQ_API_KEY_2=
# Optional overrides
VITE_GROQ_BASE_URL=https://api.groq.com/openai/v1
VITE_GROQ_MODEL_20B=openai/gpt-oss-20b
VITE_GROQ_MODEL_120B=openai/gpt-oss-120b
