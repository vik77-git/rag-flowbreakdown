# --- Groq ---
# Two keys are rotated: 5 requests per key, then a 30s cooldown on that key.
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL_20B=openai/gpt-oss-20b
GROQ_MODEL_120B=openai/gpt-oss-120b
GROQ_REQUESTS_PER_KEY=5
GROQ_KEY_COOLDOWN_SECONDS=30
GROQ_TIMEOUT_SECONDS=120

# --- Models ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=openai/gpt-oss-20b

# --- Storage ---
CHROMA_PATH=./data/chroma
UPLOAD_DIR=./data/uploads
PROCESSED_DIR=./data/processed

# --- Retrieval ---
TOP_K_VECTOR=30
TOP_K_BM25=30
TOP_K_RERANK=8
SEMANTIC_THRESHOLD_PERCENTILE=95
MIN_CHUNK_CHARS=200
MAX_CHUNK_CHARS=1800
CHUNK_OVERLAP_SENTENCES=1
CONTEXT_TOKEN_BUDGET=6000
RELEVANCE_THRESHOLD=0.25

# --- Uploads ---
MAX_UPLOAD_MB=25

# --- Prompting ---
SYSTEM_PROMPT=You are an enterprise document analyst. Answer strictly from the supplied context. Cite every claim with [n] matching the given sources. If the context is insufficient, say so plainly. Never invent documents, pages or sections. Use markdown; use tables for comparisons and fenced code blocks for code.
